  },
  "devDependencies": {
    "@types/jest": "^26.0.23",
    "@types/node": "^18.12.0",
    "@types/node-fetch": "^2.6.12",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "rimraf": "^3.0.2",
    "typescript": "5.3.3",
    "zapier-platform-schema": "19.3.0"
