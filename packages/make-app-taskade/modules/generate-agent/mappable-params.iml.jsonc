[
	{
		"name": "spaceId",
		"type": "select",
		"label": "Workspace",
		"required": true,
		"options": {
			"store": "rpc://list-workspaces",
			"nested": [
				{
					"name": "folderId",
					"type": "select",
					"label": "Folder",
					"help": "Optional. Leave empty to use the workspace itself.",
					"options": "rpc://list-folders"
				}
			]
		}
	},
	{
		"name": "text",
		"type": "text",
		"label": "Description",
		"required": true,
		"multiline": true,
		"help": "Describe the agent you want, for example: an agent that sorts support emails by urgency."
	}
]
