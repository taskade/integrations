[
	{
		"name": "spaceId",
		"type": "select",
		"label": "Workspace",
		"required": true,
		"options": {
			"store": "rpc://list-workspaces",
			"nested": [
				{
					"name": "folderId",
					"type": "select",
					"label": "Folder",
					"help": "Optional. Leave empty to use the workspace itself.",
					"options": "rpc://list-folders"
				}
			]
		}
	},
	{
		"name": "limit",
		"type": "uinteger",
		"label": "Limit",
		"default": 10,
		"required": true,
		"help": "The maximum number of results to return in one execution cycle."
	}
]
