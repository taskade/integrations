[
	{
		"name": "spaceId",
		"type": "select",
		"label": "Workspace",
		"required": true,
		"options": {
			"store": "rpc://list-workspaces",
			"nested": [
				{
					"name": "folderId",
					"type": "select",
					"label": "Folder",
					"help": "Optional. Leave empty to use the workspace itself.",
					"options": {
						"store": "rpc://list-folders",
						"nested": [
							{
								"name": "agentId",
								"type": "select",
								"label": "AI agent",
								"required": true,
								"options": "rpc://list-agents"
							}
						],
						"placeholder": {
							"label": "Use the workspace",
							"nested": [
								{
									"name": "agentId",
									"type": "select",
									"label": "AI agent",
									"required": true,
									"options": "rpc://list-agents"
								}
							]
						}
					}
				}
			]
		}
	},
	{
		"name": "prompt",
		"type": "text",
		"label": "Prompt",
		"required": true,
		"multiline": true,
		"help": "Each run uses AI credits from your Taskade plan. Make stops a module after 40 seconds. If the agent needs longer, Make shows an error, but Taskade still finishes the run and uses the credits. Do not turn on automatic retries for this module, because each retry runs the agent again."
	}
]
