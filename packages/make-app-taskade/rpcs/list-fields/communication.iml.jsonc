{
	"url": "/v2/listFields",
	"method": "POST",
	"body": {
		"projectId": "{{parameters.projectId}}"
	},
	"response": {
		"limit": 500,
		"iterate": "{{body.items}}",
		"output": {
			"label": "{{ifempty(item.data.displayName, ifempty(item.data.title, item.id))}}",
			"value": "{{item.id}}"
		}
	}
}
