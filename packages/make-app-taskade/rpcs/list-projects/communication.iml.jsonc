{
	"url": "/v2/listMyProjects",
	"method": "POST",
	"body": {
		"limit": 100,
		"page": 1
	},
	"response": {
		"limit": 500,
		"iterate": "{{body.items}}",
		"output": {
			"label": "{{ifempty(item.name, item.id)}}",
			"value": "{{item.id}}"
		}
	},
	"pagination": {
		"body": {
			"limit": 100,
			"page": "{{pagination.page}}"
		},
		"condition": "{{length(body.items) >= 100}}"
	}
}
