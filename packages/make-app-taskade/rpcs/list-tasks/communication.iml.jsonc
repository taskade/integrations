{
	"url": "/v2/listTasks",
	"method": "POST",
	"body": {
		"projectId": "{{parameters.projectId}}",
		"limit": 100
	},
	"response": {
		"limit": 500,
		"iterate": "{{body.items}}",
		"output": {
			"label": "{{ifempty(item.text, item.id)}}",
			"value": "{{item.id}}"
		}
	},
	"pagination": {
		"body": {
			"projectId": "{{parameters.projectId}}",
			"limit": 100,
			"after": "{{get(last(body.items), 'id')}}"
		},
		"condition": "{{length(body.items) >= 100}}"
	}
}
