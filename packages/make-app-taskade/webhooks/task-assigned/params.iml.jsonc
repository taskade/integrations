[
	{
		"name": "spaceIds",
		"type": "select",
		"label": "Workspaces",
		"multiple": true,
		"options": "rpc://list-workspaces",
		"help": "Only get events from these workspaces. A workspace does not include its folders. Leave this and Folder IDs empty to get events from everything you can access."
	},
	{
		"name": "folderIds",
		"type": "array",
		"label": "Folder IDs",
		"spec": {
			"type": "text",
			"label": "Folder ID"
		},
		"help": "Also get events from these folders. To find folder IDs, run Make an API Call with `POST /v2/listFolders` and the body `{\"spaceId\": \"<workspace ID>\"}`."
	}
]
